[Unit]
Description=Twice-weekly Apple Health narrative digest via Screddy /chat
After=network.target

[Service]
Type=oneshot
# Adjust paths for your install. %h expands to the running user's home directory.
EnvironmentFile=%h/screddy-health/.env
WorkingDirectory=%h/screddy-health
ExecStart=%h/.local/bin/uv run python -m screddy.agents.health_digest
StandardOutput=append:%h/logs/health-digest.log
StandardError=append:%h/logs/health-digest.log

[Install]
WantedBy=default.target
