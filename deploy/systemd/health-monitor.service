[Unit]
Description=Daily Apple Health watchdog — analysis + emergency edge-trigger
After=network.target

[Service]
Type=oneshot
# Adjust paths for your install. %h expands to the running user's home directory.
EnvironmentFile=%h/screddy-health/.env
WorkingDirectory=%h/screddy-health
ExecStart=%h/.local/bin/uv run python -m screddy.agents.health_monitor
StandardOutput=append:%h/logs/health-monitor.log
StandardError=append:%h/logs/health-monitor.log

[Install]
WantedBy=default.target
