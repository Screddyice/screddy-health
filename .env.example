# Copy this to .env and fill in. Never commit .env (already in .gitignore).

# ─── Apple Health Auto Export (required) ──────────────────────────────────
# URL of your Health Auto Export companion server.
APPLE_HEALTH_REMOTE_BASE_URL=https://your-hae-server.example.com
# Read API token from your HAE server config.
APPLE_HEALTH_REMOTE_READ_TOKEN=sk-your-hae-token

# ─── Telegram delivery (required) ─────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then start a chat with it.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-replace-this
TELEGRAM_CHAT_ID=000000000

# ─── LLM endpoint for digest generation (required for health_digest) ──────
# Endpoint must accept POST {url} with {"message": "..."} JSON body and
# return {"answer": "..."} JSON. Bearer auth with SCREDDY_API_TOKEN.
SCREDDY_API_URL=http://127.0.0.1:8200/chat
SCREDDY_API_TOKEN=replace-with-your-bearer-token

# ─── Email mirror (optional) ──────────────────────────────────────────────
# Set ANY of these to receive sickness + emergency alerts via email.
# Falls back chain: SICKNESS → EMERGENCY → SCREDDY_HEALTH_EMAIL_TO.
# If all three are unset, email mirror silently no-ops.
# SCREDDY_HEALTH_EMAIL_TO=you@example.com
# SCREDDY_HEALTH_EMERGENCY_EMAIL_TO=emergency-only@example.com
# SCREDDY_HEALTH_SICKNESS_EMAIL_TO=sickness-only@example.com

# ─── Optional Postgres for durable history ────────────────────────────────
# When set, watchdog writes per-metric daily rows to a `health_metrics`
# table and the digest reads journal entries from an `observations` table
# (tagged `mental-health` + `journal`). When unset, everything works on
# JSONL + Telegram with no DB.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Path + timezone overrides (optional) ─────────────────────────────────
# SCREDDY_HEALTH_JSONL_LOG_PATH=~/logs/health-monitor.jsonl
# SCREDDY_HEALTH_STATE_DIR=~/screddy-health/state
# SCREDDY_HEALTH_TZ=America/Los_Angeles
